# ==========================================
# Sada-e-Kisan Monorepo — Master .gitignore
# ==========================================

# Dependencies (Frontend & Backend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Variables & Secrets (NEVER commit)
.env
.env.local
.env.*.local
*.pem
*.key
*.p8
*.p12
*.jks
*.mobileprovision

# Expo & React Native (frontend/)
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
frontend/ios/
frontend/android/
*.tsbuildinfo

# NestJS Cloud Backend (backend/)
backend/dist/
backend/uploads/

# Python AI Microservice (ai-services/)
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
ai-services/app/weights/*.pt
ai-services/app/weights/*.pth
ai-services/app/weights/*.onnx

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
